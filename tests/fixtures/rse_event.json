{"id":27015,"title":"Ötztaler Radmarathon","description":"Der Ötztaler Radmarathon zählt zu den anspruchsvollsten und bekanntesten Jedermann-Radmarathons Europas. Er findet in Tirol in Österreich statt und führt durch eine beeindruckende Hochgebirgslandschaft der Alpen. \nDie Strecke umfasst 227 km mit 5500 Höhenmetern und führt über vier große Alpenpässe durch Österreich sowie Italien und verlangt den Teilnehmern eine außergewöhnliche Ausdauer, eine gute Renneinteilung und mentale Stärke ab.","address":"BP Tankstelle, Dorfstraße 114, 6450 Sölden","locationName":"BP Tankstelle","street":"Dorfstraße","houseNumber":"114","postalCode":"6450","city":"Sölden","bundesland":"Tirol","country":"AT","eventDate":"2027-08-29","startTime":"06:30","startTimeEnd":null,"participants":4000,"organizer":"Ötztal Tourismus – Körperschaft des öffentlichen Rechts","organizerId":679,"category":"ROAD","secondaryCategories":[],"eventType":"RADMARATHON","organizerUrl":"www.oetztaler-radmarathon.com/","flyerUrl":null,"flyerUploaded":false,"imageUrl":"https://api.radsport-events.de/api/v1/events/27015/image?v=1785559333251","imageUploaded":true,"imageCredit":"Foto: Ötztal Tourismus / Lukas Ennemoser","imageAiGenerated":false,"imageFocusX":34,"imageFocusY":79,"organizerLogoUrl":null,"organizerPhotoUrl":null,"fullyBooked":false,"cancelled":false,"tentative":false,"permanent":false,"seasonFrom":null,"seasonUntil":null,"areaName":null,"areaBounds":null,"registrationStatus":"NOT_YET_OPEN","registrationNoticeAvailable":true,"priceTiers":[],"status":"PUBLISHED","active":true,"createdBy":null,"createdAt":"2026-07-17T11:53:35.395+00:00","updatedAt":"2026-10-14T18:00:01.866+00:00","distances":[{"id":31606,"distanceKm":227.00,"elevationMeters":5500,"routeUrl":null,"label":null,"hasGpx":true,"durationMinutes":null,"eventType":null,"startTime":null}],"komootCollectionUrl":null,"favorited":false,"latitude":46.9650277,"longitude":11.0070006,"favoriteCount":28,"links":[{"id":780,"url":"https://www.instagram.co